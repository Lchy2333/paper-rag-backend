# paper-rag-backend 环境变量模板（本文件入库；真实 .env 不入库，见 .gitignore）
# 用法：复制为 .env 后按需取消注释。工作目录须为仓库根（go run / 容器 WORKDIR /app）。
# 优先级：真实环境变量（系统 export / compose env_file）> .env > config.yaml 占位符缺省值。

# ── 数据库（必填，无缺省值——config.yaml 校验会拦截空密码）──
# POSTGRES_PASSWORD=
# POSTGRES_HOST=localhost        # 容器/生产注入 postgres（compose 服务名）

# ── 外部服务密钥（必填，无缺省值）──
# SILICONFLOW_API_KEY=

# ── 连接池与摄入并发（可选，缺省值与 config.yaml 占位符一致）──
# DB_MAX_CONNS=10                # database.max_conns：DB 连接池上限
# INGEST_WORKERS=2               # rag.ingest_workers：异步摄入 worker 数
